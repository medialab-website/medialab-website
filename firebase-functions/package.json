{
  "name": "firebase-functions",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild index.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --external:firebase-functions --external:firebase-admin --external:googleapis"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
