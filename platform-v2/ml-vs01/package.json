{
  "name": "@medialab/vs01-repair-p01a",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "migrate:dev": "tsx db/migrate.ts",
    "migrate:test": "tsx db/migrate.ts --test",
    "db:seed": "tsx db/seed.ts",
    "db:seed:test": "tsx db/seed.ts --test",
    "db:reset:test": "tsx db/reset-test-database.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "verify:dependencies": "tsx scripts/verify-dependencies-exact.ts",
    "verify:placeholders": "tsx scripts/verify-no-placeholders.ts",
    "verify:changed-files": "tsx scripts/verify-changed-files.ts",
    "verify:migration-engine": "tsx scripts/verify-migration-engine.ts",
    "verify:identity-tenancy-schema": "tsx scripts/verify-identity-tenancy-schema.ts",
    "verify:property-snapshot-schema": "tsx scripts/verify-property-snapshot-schema.ts",
    "verify:person-contacts-account-lifecycle-schema": "tsx scripts/verify-person-contacts-account-lifecycle-schema.ts",
    "verify:property-hub-foundation-schema": "tsx scripts/verify-property-hub-foundation-schema.ts",
    "verify:scheduling-appointment-foundation-schema": "tsx scripts/verify-scheduling-appointment-foundation-schema.ts",
    "verify:job-service-workstream-foundation-schema": "tsx scripts/verify-job-service-workstream-foundation-schema.ts",
    "verify:mission-plan-foundation-schema": "tsx scripts/verify-mission-plan-foundation-schema.ts",
    "verify:foundation-closeout": "tsx scripts/verify-foundation-closeout.ts",
    "verify:all": "npm run typecheck && npm run test && npm run verify:runtime && npm run verify:dependencies && npm run verify:placeholders && npm run verify:changed-files && npm run verify:migration-engine && npm run verify:identity-tenancy-schema && npm run verify:property-snapshot-schema && npm run verify:person-contacts-account-lifecycle-schema && npm run verify:property-hub-foundation-schema && npm run verify:scheduling-appointment-foundation-schema && npm run verify:job-service-workstream-foundation-schema && npm run verify:mission-plan-foundation-schema && npm run verify:foundation-closeout"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
